{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "hardhat.config.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "test-support/**/*.ts",
    "src/**/*.ts",
    "cli/**/*.ts",
    "mcp/**/*.ts",
    "artifacts/**/*.d.ts"
  ]
}
